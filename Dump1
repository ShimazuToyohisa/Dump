'<style>table.cochiseTable tr:has(.ligne-rouge) td { color: red !important; } table.cochiseTable tr:has(.ligne-rouge) a { color: red !important; } table.cochiseTable tr:has(.ligne-rouge) span { color: red !important; } table.cochiseTable tr:has(.ligne-gras) td { font-weight: bold !important; font-size: 14px !important; } table.cochiseTable tr:has(.ligne-gras) a { font-weight: bold !important; font-size: 14px !important; }</style><script>Array.from(document.querySelectorAll("table.cochiseTable tr")).forEach(tr=>{tr.onclick=(e)=>{tr.style.backgroundColor=tr.style.backgroundColor!="rgb(242, 230, 195)"?"rgb(242, 230, 195)":"transparent"}})</script>' || case when sup_OperationOrdreFabrication_suivi_interne_de_fabrication_of.alpha like '%DMDATL%' then ('<span class="ligne-rouge"></span>') when exists(select op.id from OperationOrdreFabricationEntite as op left outer join op.attributSupplementaire as suivi with index(suivi) = 'sup_OperationOrdreFabrication_suivi_interne_de_fabrication_of' where suivi.alpha like '%IMPERATIF%' and op.ordreFabrication.codeOF like ordreFabrication.codeOF) then ('<span class="ligne-gras"></span>') else ('') end
