'<script>Array.from(document.querySelectorAll("table.cochiseTable tr")).forEach(tr=>{tr.onclick=(e)=>{tr.style.backgroundColor=tr.style.backgroundColor!="rgb(242, 230, 195)"?"rgb(242, 230, 195)":"transparent"}})</script>' ||
case
  when sup_OperationOrdreFabrication_suivi_interne_de_fabrication_of.alpha like '%DMDATL%' then
    '<img src="x" onerror="var r=this.closest(`tr`);if(r){r.style.color=`red`;r.querySelectorAll(`td,a`).forEach(e=>e.style.color=`red`);}this.remove();"/>'
  when exists(select op.id from OperationOrdreFabricationEntite as op left outer join op.attributSupplementaire as suivi with index(suivi) = 'sup_OperationOrdreFabrication_suivi_interne_de_fabrication_of' where suivi.alpha like '%IMPERATIF%' and op.ordreFabrication.codeOF like ordreFabrication.codeOF) then
    '<img src="x" onerror="var r=this.closest(`tr`);if(r){r.style.fontWeight=`bold`;r.style.fontSize=`14px`;}this.remove();"/>'
  else ''
end
